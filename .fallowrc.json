{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    // Test files and test helpers are entry points — vitest discovers them via
    // its include glob, but fallow doesn't parse vitest config. Without these
    // patterns, all test files and test-only helpers appear as unused files.
    "**/*.{test,spec}.{ts,tsx,js,jsx}",
    "**/test/**/*.ts",
    "**/tests/**/*.ts"
  ],
  // @forge-ahead/remote and @forge-ahead/errors are consumed as external
  // GitHub dependencies, so exported symbols that are unused within the repo
  // are not dead code.
  "publicPackages": ["@forge-ahead/remote", "@forge-ahead/errors"],
  // The vendored reference project is outside this simulator's analysis scope.
  "ignorePatterns": ["vendor/**"],
  "duplicates": {
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {}
}
