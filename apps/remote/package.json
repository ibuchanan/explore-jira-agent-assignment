{
  "name": "rovo-agent-connector-remote-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "the minimum Forge Remote backend for Rovo Agent Connector",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:test": "rm -rf dist && tsc --project tsconfig.test.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "npm run lint:check",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "start": "npm run build && node dist/index.js",
    "test": "npm run build:test && node --test dist/test/server.test.js",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0",
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    "@forge-ahead/remote": "github:ibuchanan/forge-ahead-remote",
    "express": "^5.2",
    "yaml": "^2.8"
  },
  "devDependencies": {
    "@types/express": "^5.0"
  }
}
